{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-sentinel-forge.local/schemas/api-sentinel/Anomaly/v1",
  "title": "api-sentinel/Anomaly/v1",
  "type": "object",
  "required": ["schema", "anomaly_id", "service_id", "detected_at", "rule", "severity", "explanation", "evidence_refs", "unknowns"],
  "properties": {
    "schema": { "const": "api-sentinel/Anomaly/v1" },
    "anomaly_id": { "type": "string" },
    "service_id": { "type": "string" },
    "operation_id": { "type": ["string", "null"] },
    "detected_at": { "type": "string", "format": "date-time" },
    "rule": {
      "type": "object",
      "required": ["rule_id", "rule_version"],
      "properties": {
        "rule_id": { "type": "string" },
        "rule_version": { "type": "string" }
      }
    },
    "severity": { "type": "string", "enum": ["SEV1", "SEV2", "SEV3", "SEV4", "INFORMATIONAL"] },
    "explanation": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "math": { "type": "string", "description": "the exact formula/inputs that triggered detection" }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
